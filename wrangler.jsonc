{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "shorturls",
	"main": ".svelte-kit/cloudflare/_worker.js",
    "compatibility_date": "2026-02-05",
    "compatibility_flags": [
        "nodejs_compat"
    ],
    "workers_dev": false,
	"assets": {
		"binding": "ASSETS",
		"directory": ".svelte-kit/cloudflare",
	},
    "kv_namespaces": [
        {
            "binding": "SHORT_URLS",
            "id": "7eb6e961fca04d1495fd5561985a1e17",
        },
    ],
}