PASSWORD=examplepassword
SECRET=your-secret-to-sign-cookies

# Where the app is hosted, used for generating short URLs and validating redirects.
PUBLIC_HOSTNAME=your-domain.com

# Optional external fallback target for unknown short URLs.
# Accepts hostname or full URL (e.g. https://example.com or example.com/base).
# If this resolves to the same hostname as PUBLIC_HOSTNAME,
# the app falls back to internal / or /login to avoid redirect loops.
# PUBLIC_REDIRECT_FALLBACK_BASE=https://your-domain.com
PUBLIC_REDIRECT_FALLBACK_BASE=somewhere-else.com